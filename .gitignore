# Swift / SPM
.build/
.swiftpm/
Packages/
Package.resolved

# Xcode
DerivedData/
build/
build-dev/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated from xcodegen / Info.plist
# (regenerate via `xcodegen generate`)
Nice.xcodeproj/
Resources/Info.generated.plist

# Release signing credentials (sourced by scripts/release.sh for local runs)
scripts/.env.release

# Crash-recovery backup written by scripts/test.sh and scripts/install.sh
# while project.yml is being patched. Cleaned up on clean exit; if it
# survives a run, the next script invocation uses it to restore.
.scripts-project-yml.bak

# Runtime lock file written by Claude Code's `/loop` scheduler. Lives
# per-worktree so it doesn't conflict with parallel loops elsewhere;
# never meant to be committed.
.claude/scheduled_tasks.lock

# Task briefs the /nice-dispatch skill writes before opening a dispatched
# worktree session. They always land in the MAIN checkout (the dispatched
# session's cwd becomes the worktree, so the brief has to live outside it)
# and accumulate with no cleanup story — ignore them so they never pollute
# `git status`.
/.claude/dispatch/

# Rust rewrite (Path B)
# Vendored pinned zed/GPUI checkout (~1 GB) — reproduced by
# scripts/vendor-zed.sh from patches/zed-bg-luminance.patch, never committed.
# No trailing slash: in the main checkout this is a real directory, but a
# `claude -w` worktree gets a `vendor` SYMLINK to the main checkout (created by
# scripts/worktree-link-vendor.sh) — a trailing-slash rule wouldn't match the
# symlink, so it would show up as committable. This ignores both.
/vendor
# Cargo build output.
/target/
# Worktree-only cargo config written by scripts/worktree-link-vendor.sh:
# redirects the worktree's target-dir to the main checkout's target/ so fresh
# worktrees never cold-compile vendored gpui. The main checkout has no .cargo.
/.cargo/
# scripts/rust-bundle.sh output (the assembled "Nice RS Dev.app" bundle,
# staged before scripts/rust-install.sh copies it to /Applications).
/build-rs/
# scripts/rust-bundle.sh --prod output (the assembled prod "Nice.app"
# bundle, staged before scripts/rust-install.sh --prod copies it).
/build-rs-prod/

# macOS
.DS_Store
