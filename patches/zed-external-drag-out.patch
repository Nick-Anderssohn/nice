+    // Nice patch (external-drag-out): start a real NSDraggingSession carrying
+    // one file URL per path, with the GPUIView as the NSDraggingSource.
+    //
+    // AppKit requires the NSEvent that armed the drag; we take it from
+    // `[NSApp currentEvent]`, which during synchronous mouse-event dispatch IS
+    // the left-mouse-down/dragged event being handled. Calling this outside
+    // that window (a deferred task, a key handler) leaves a non-mouse or stale
+    // current event — we detect that and refuse instead of letting AppKit
+    // raise. The session is delivered to our own window through the existing
+    // drag DESTINATION path (`draggingEntered:` … `performDragOperation:`)
+    // exactly like a Finder-initiated drop.
+    fn begin_external_paths_drag(&self, paths: &[PathBuf]) -> bool {
+        if paths.is_empty() {
+            return false;
+        }
+        let native_view = self.0.as_ref().lock().native_view.as_ptr();
+        unsafe {
+            let pool = NSAutoreleasePool::new(nil);
+            let began = begin_external_paths_drag_on_view(native_view, paths);
+            let _: () = msg_send![pool, release];
