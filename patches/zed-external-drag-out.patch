+// Nice patch (external-drag-out): build one NSDraggingItem per path (file URL
+// pasteboard writer + the Finder icon as the drag image) and hand them to
+// AppKit as a real drag session rooted at the event currently being dispatched.
+//
+// Returns false — rather than raising — when there is no usable triggering
+// event, which is what happens if this is called outside synchronous mouse
+// handling. Caller supplies the autorelease pool.
+unsafe fn begin_external_paths_drag_on_view(native_view: id, paths: &[PathBuf]) -> bool {
+    unsafe {
+        let app = NSApplication::sharedApplication(nil);
+        let event: id = msg_send![app, currentEvent];
+        if event == nil {
+            return false;
+        }
+        // AppKit only accepts a mouse-down/dragged event as the session's
+        // trigger; anything else means we are not inside a live drag gesture.
+        let event_type = NSEvent::eventType(event) as u64;
+        if event_type != NSEventTypeLeftMouseDown && event_type != NSEventTypeLeftMouseDragged {
+            return false;
+        }
+
+        let location: NSPoint = msg_send![event, locationInWindow];
+        let center: NSPoint = msg_send![native_view, convertPoint: location fromView: nil];
+        let frame = NSRect::new(
+            NSPoint::new(
+                center.x - EXTERNAL_DRAG_ICON_SIZE / 2.0,
+                center.y - EXTERNAL_DRAG_ICON_SIZE / 2.0,
+            ),
+            NSSize::new(EXTERNAL_DRAG_ICON_SIZE, EXTERNAL_DRAG_ICON_SIZE),
+        );
+        let icon_size = NSSize::new(EXTERNAL_DRAG_ICON_SIZE, EXTERNAL_DRAG_ICON_SIZE);
+
+        let workspace: id = msg_send![class!(NSWorkspace), sharedWorkspace];
+        let items: id = msg_send![class!(NSMutableArray), array];
+        for path in paths {
+            let Some(path) = path.to_str() else { continue };
+            let ns_path: id = NSString::alloc(nil).init_str(path);
+            let ns_path: id = msg_send![ns_path, autorelease];
+            let url: id = msg_send![class!(NSURL), fileURLWithPath: ns_path];
+            if url == nil {
+                continue;
+            }
+            let item: id = msg_send![class!(NSDraggingItem), alloc];
+            let item: id = msg_send![item, initWithPasteboardWriter: url];
+            if item == nil {
+                continue;
+            }
+            let item: id = msg_send![item, autorelease];
+            let icon: id = msg_send![workspace, iconForFile: ns_path];
+            if icon != nil {
+                let _: () = msg_send![icon, setSize: icon_size];
+            }
+            // Every item shares one frame, so a multi-file drag renders as
+            // AppKit's stacked-with-count image instead of a spread of icons.
+            let _: () = msg_send![item, setDraggingFrame: frame contents: icon];
+            let _: () = msg_send![items, addObject: item];
+        }
+
+        let count: NSUInteger = msg_send![items, count];
+        if count == 0 {
+            return false;
+        }
+
+        let session: id = msg_send![
+            native_view,
+            beginDraggingSessionWithItems: items
+            event: event
+            source: native_view
+        ];
+        session != nil
+    }
+}
+
+// Nice patch (external-drag-out): NSDraggingSource operation mask. Outside the
+// app we only ever offer a copy (we never hand ownership of the files away);
+// inside it we permit copy + generic so Nice's own drop targets keep deciding
+// move-vs-copy from the modifier keys and the volume check.
+extern "C" fn dragging_session_source_operation_mask(
+    _: &Object,
+    _: Sel,
+    _session: id,
+    context: NSInteger,
+) -> NSDragOperation {
+    if context == NSDraggingContextOutsideApplication {
+        NSDragOperationCopy
+    } else {
+        NSDragOperationCopy | NSDragOperationGeneric
+    }
+}
