+/// Strength of the bg-aware text composition curve on low-density (1x)
+/// displays, in [0, 1] (1 = the full retina-calibrated curve, 0 = off).
+/// Defaults to 0.5: at 1x the curve's boosted antialias fringe is a full
+/// point per stem edge (vs half on retina), so full strength reads fat and
+/// fully off reads thin. `NICE_1X_TEXT_CURVE=<0..1>` overrides it — a live
+/// A/B knob for feel checks. Cached for the process.
+fn low_density_curve_strength() -> f32 {
+    static STRENGTH: std::sync::OnceLock<f32> = std::sync::OnceLock::new();
+    *STRENGTH.get_or_init(|| {
+        std::env::var("NICE_1X_TEXT_CURVE")
+            .ok()
+            .and_then(|v| v.parse::<f32>().ok())
+            .map_or(0.5, |v| v.clamp(0.0, 1.0))
+    })
+}
