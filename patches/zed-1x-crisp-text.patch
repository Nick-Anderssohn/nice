+/// Whether the bg-aware text composition curve stays enabled on low-density
+/// (1x) displays. Off by default there (the curve's boosted antialias fringe
+/// is a full point per edge at 1x — text reads fat); `NICE_1X_TEXT_CURVE=1`
+/// re-enables it as a live A/B knob for feel checks. Cached for the process.
+fn low_density_curve_enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("NICE_1X_TEXT_CURVE").is_ok_and(|v| v == "1"))
+}
